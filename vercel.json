{
  "version": 2,
 
    "GROQ_API_KEY": "@groq_api_key"
  },

{
  "version": 2,
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/features", "destination": "/pages/features/index.html" },
    { "source": "/about", "destination": "/pages/about/index.html" },
    { "source": "/pricing", "destination": "/pages/pricing/index.html" },
    { "source": "/blog", "destination": "/pages/blog/index.html" },
    { "source": "/demo", "destination": "/pages/demo/index.html" },
    { "source": "/contact", "destination": "/pages/contact/index.html" },
    { "source": "/register", "destination": "/pages/auth/register.html" },
    { "source": "/login", "destination": "/pages/auth/login.html" },
    { "source": "/get-started", "destination": "/pages/auth/get-started.html" }
  ]
}
